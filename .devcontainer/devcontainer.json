{
	"name": "dbt Zero to Hero",
	"image": "ghcr.io/zoltanctoth/complete-dbt-bootcamp-zero-to-hero/dbt-bootcamp-devcontainer:latest",
	"forwardPorts": [
		5000
	],
	"postCreateCommand": "uv sync --frozen --no-install-project && mkdir -p ~/.snowflake && printf '%s' \"$SNOWFLAKE_PRIVATE_KEY\" > ~/.snowflake/rsa_key.p8 && chmod 600 ~/.snowflake/rsa_key.p8",
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/opt/venv/bin/python",
				"extensions.ignoreRecommendations": true,
				"settingsSync.enabled": false,
				"python.terminal.useEnvFile": false
			}
		}
	}
}